# =============================================
# PixelOffice 環境變數範例
# 複製為 .env 後填寫（Windows PowerShell）：
#   Copy-Item .env.example .env
# .env 已在 .gitignore，不會進版控
# =============================================

# 後端 port（預設 3001；前端 port 改 config.json 的 port 欄位）
PORT=3001

# ---- 股票情報 skill（skills/stock）----
# Gateway 認證 token；沒填會 401，只剩 viewer 公開報告段可用
STOCK_GATEWAY_TOKEN=
# 以下選填，不填用括號內預設值
#STOCK_GATEWAY_URL=http://localhost:8815
#STOCK_VIEWER_URL=http://localhost:8814
# 停用股票 skill（等同資料夾 _ 開頭停用，免改檔名）：0 停用 / 1 啟用
#STOCK_PLUGIN_ENABLED=1

# ---- 網頁摘要 skill（skills/websearch）----
# 自建 local-websearch 位址（預設 http://localhost:8008）
#WEBSEARCH_URL=http://localhost:8008
