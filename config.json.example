{
  "port": 8881,
  "gameLoop": {
    "heartbeatIntervalMs": 3000,
    "behaviorWeights": {
      "goCoffee": 0.3,
      "visitColleague": 0.3,
      "stayDesk": 0.4
    },
    "dialogueTrigger": {
      "minIntervalMs": 6000,
      "chance": 0.4
    }
  },
  "models": {
    "label": "Ollama",
    "model": "ollama"
  },
  "providers": {
    "ollama": {
      "type": "cloud",
      "sdk": "ollama",
      "apiKey": "YOUR_AGNES_API_KEY",
      "description": "Ollama Cloud",
      "baseURL": "https://ollama.com",
      "defaultModel": "gemma4:31b-cloud"
    }
  }
}
