{
  "gameLoop": {
    "heartbeatIntervalMs": 3000,
    "behaviorWeights": {
      "goCoffee": 0.3,
      "visitColleague": 0.3,
      "stayDesk": 0.4
    },
    "dialogueTrigger": {
      "minIntervalMs": 6000,
      "chance": 0.4
    }
  },
  "providers": {
    "agnes-ai": {
      "type": "cloud",
      "sdk": "openai",
      "apiKey": "YOUR_AGNES_API_KEY",
      "description": "Agnes",
      "baseURL": "https://apihub.agnes-ai.com/v1",
      "defaultModel": "agnes-2.0-flash"
    }
  }
}
